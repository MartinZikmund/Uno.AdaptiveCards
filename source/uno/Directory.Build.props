<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS1591;NU1507;NETSDK1201;PRI257</NoWarn>
    <Authors>Martin Zikmund; Microsoft</Authors>
    <Copyright>Copyright (c) Microsoft Corporation. Licensed under the MIT License.</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/MartinZikmund/Uno.AdaptiveCards</RepositoryUrl>
    <PackageTags>adaptivecards;adaptive-cards;uno;unoplatform;winui</PackageTags>
    <Version>0.1.0-dev</Version>
  </PropertyGroup>

  <!--
    Uno target frameworks. Desktop (Skia) and WebAssembly build everywhere. Android/iOS need the corresponding
    .NET workloads (opt in on Linux with -p:EnableMobileTargets=true), Windows App SDK builds on Windows only.
    Set OverrideTargetFrameworks to build a specific subset.
  -->
  <PropertyGroup>
    <UnoTargetFrameworks>net10.0-browserwasm;net10.0-desktop</UnoTargetFrameworks>
    <UnoTargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('Linux')) or '$(EnableMobileTargets)'=='true'">$(UnoTargetFrameworks);net10.0-android;net10.0-ios</UnoTargetFrameworks>
    <UnoTargetFrameworks Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(UnoTargetFrameworks);net10.0-windows10.0.26100</UnoTargetFrameworks>
    <UnoTargetFrameworks Condition="'$(OverrideTargetFrameworks)'!=''">$(OverrideTargetFrameworks)</UnoTargetFrameworks>
  </PropertyGroup>
</Project>
